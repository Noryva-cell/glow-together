{
  "name": "Program",
  "type": "object",
  "properties": {
    "domain": {
      "type": "string",
      "default": "sport"
    },
    "objective": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "start_level": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "safety": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "review_weeks": {
      "type": "number",
      "default": 2
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "default": "actif"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "criteria": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "minutes": {
            "type": "number"
          },
          "materials": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          },
          "errors": {
            "type": "string"
          },
          "adaptations": {
            "type": "string"
          },
          "caution": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "minutes": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "domain",
    "objective"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}