{
  "name": "AssistantMessage",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "default": "user"
    },
    "content": {
      "type": "string"
    },
    "mood": {
      "type": "string",
      "default": "explication"
    },
    "actions_json": {
      "type": "string",
      "default": "[]"
    }
  },
  "required": [
    "role",
    "content"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}