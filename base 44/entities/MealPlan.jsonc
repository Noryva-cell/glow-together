{
  "name": "MealPlan",
  "type": "object",
  "properties": {
    "date": {
      "type": "string"
    },
    "meal_type": {
      "type": "string",
      "default": "dejeuner"
    },
    "recipe_id": {
      "type": "string"
    },
    "servings": {
      "type": "number",
      "default": 2
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "date",
    "meal_type",
    "recipe_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}