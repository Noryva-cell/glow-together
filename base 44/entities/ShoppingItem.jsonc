{
  "name": "ShoppingItem",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "quantity": {
      "type": "string"
    },
    "rayon": {
      "type": "string",
      "default": "Autre"
    },
    "week_start": {
      "type": "string"
    },
    "checked": {
      "type": "boolean",
      "default": false
    },
    "recipe_id": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "week_start"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}