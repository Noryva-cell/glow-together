{
  "name": "ActivityFeedback",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "template_id": {
      "type": "string"
    },
    "program_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "reussi"
    },
    "difficulty": {
      "type": "string"
    },
    "feeling": {
      "type": "number"
    },
    "note": {
      "type": "string"
    },
    "pain": {
      "type": "boolean",
      "default": false
    },
    "done_steps": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  },
  "required": [
    "title",
    "date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}