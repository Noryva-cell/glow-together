{
  "name": "TimeBlock",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "travail"
    },
    "day_of_week": {
      "type": "number"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "recurring": {
      "type": "boolean",
      "default": true
    },
    "date": {
      "type": "string"
    }
  },
  "required": [
    "label",
    "start_time",
    "end_time"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}