{
  "name": "RoutineLog",
  "type": "object",
  "properties": {
    "routine_id": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "done_steps": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "routine_id",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}