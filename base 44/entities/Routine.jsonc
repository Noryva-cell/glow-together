{
  "name": "Routine",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "moment": {
      "type": "string",
      "default": "matin"
    },
    "category": {
      "type": "string",
      "default": "beaute"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "days": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}