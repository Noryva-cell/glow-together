{
  "name": "CultureLesson",
  "type": "object",
  "properties": {
    "topic": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "default": "d\u00e9butant"
    },
    "minutes": {
      "type": "number",
      "default": 15
    },
    "content": {
      "type": "string"
    },
    "takeaways": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "topic",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}